---
// 场景交互动画：seaside / mountain / city / spring / summer / autumn / winter
interface Props { scene: string; }
const { scene } = Astro.props;
---
{scene === 'seaside' && (
<div class="scene scene-seaside" aria-hidden="true">
  <svg viewBox="0 0 800 220" preserveAspectRatio="none">
    <defs>
      <linearGradient id="ss-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffe3c2"/><stop offset="1" stop-color="#ffc9a3"/>
      </linearGradient>
      <linearGradient id="ss-sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7fa8c4"/><stop offset="1" stop-color="#4d6f8a"/>
      </linearGradient>
    </defs>
    <rect width="800" height="220" fill="url(#ss-sky)"/>
    <circle cx="640" cy="60" r="30" fill="#ffbe7a" class="ss-sun"/>
    <g class="ss-gull" stroke="#5a5148" stroke-width="3" fill="none" stroke-linecap="round">
      <path d="M-30 50 q 10 -12 20 0 q 10 -12 20 0"/>
    </g>
    <g class="ss-gull ss-gull2" stroke="#5a5148" stroke-width="2.5" fill="none" stroke-linecap="round">
      <path d="M-60 80 q 8 -10 16 0 q 8 -10 16 0"/>
    </g>
    <rect y="120" width="800" height="100" fill="url(#ss-sea)"/>
    <foreignObject x="0" y="110" width="800" height="110">
      <canvas class="ss-canvas" width="800" height="110" style="width:100%;height:100%;display:block"></canvas>
    </foreignObject>
  </svg>
</div>
)}

{scene === 'mountain' && (
<div class="scene scene-mountain" aria-hidden="true">
  <svg viewBox="0 0 800 240">
    <defs>
      <linearGradient id="mt-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e6eef5"/><stop offset="1" stop-color="#f7f3e8"/>
      </linearGradient>
    </defs>
    <rect width="800" height="240" fill="url(#mt-sky)"/>
    <path d="M-40 240 L200 60 L380 240 Z" fill="#a4b8a0"/>
    <path d="M240 240 L520 30 L790 240 Z" fill="#7e9a86"/>
    <path d="M520 30 L580 85 L550 80 L575 120 L520 240 L465 120 L490 80 L460 85 Z" fill="#94ac99"/>
    <path d="M478 78 L520 30 L562 78 L540 70 L520 80 L500 70 Z" fill="#fff"/>
    <!-- 登山虚线 -->
    <path class="mt-path" id="mt-trail" d="M300 240 Q 360 190 400 170 T 480 110 T 520 40"
      stroke="#d47b5c" stroke-width="3" fill="none" stroke-dasharray="6 8" stroke-linecap="round"/>
    <!-- 登山小人（随滚动沿山径上移） -->
    <g class="mt-climber">
      <circle r="7" fill="#d47b5c" stroke="#fff" stroke-width="2.5"/>
      <text y="4" text-anchor="middle" font-size="9" fill="#fff">⚑</text>
    </g>
    <!-- 旗帜 -->
    <g class="mt-flag">
      <line x1="520" y1="40" x2="520" y2="6" stroke="#5a5148" stroke-width="3"/>
      <path class="mt-flagcloth" d="M520 6 L556 14 L520 24 Z" fill="#d47b5c"/>
    </g>
    <!-- 云雾 -->
    <g class="mt-cloud" fill="#ffffff" opacity=".85">
      <ellipse cx="180" cy="120" rx="60" ry="16"/><ellipse cx="230" cy="112" rx="44" ry="14"/>
    </g>
    <g class="mt-cloud mt-cloud2" fill="#ffffff" opacity=".7">
      <ellipse cx="600" cy="150" rx="70" ry="16"/><ellipse cx="650" cy="142" rx="40" ry="12"/>
    </g>
  </svg>
</div>
)}

{scene === 'city' && (
<div class="scene scene-city" aria-hidden="true">
  <svg viewBox="0 0 800 220">
    <defs>
      <linearGradient id="ct-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2b3247"/><stop offset="1" stop-color="#4a4260"/>
      </linearGradient>
    </defs>
    <rect width="800" height="220" fill="url(#ct-sky)"/>
    <g fill="#fff" class="ct-stars">
      <circle cx="80" cy="30" r="1.6"/><circle cx="200" cy="50" r="1.2"/><circle cx="330" cy="24" r="1.5"/>
      <circle cx="470" cy="40" r="1.2"/><circle cx="600" cy="26" r="1.6"/><circle cx="720" cy="52" r="1.3"/>
    </g>
    <circle cx="680" cy="42" r="20" fill="#f2e6c8" opacity=".9"/>
    <g>
      <rect x="40" y="110" width="60" height="110" fill="#3a4055"/>
      <rect x="120" y="80" width="70" height="140" fill="#333a50"/>
      <rect x="210" y="130" width="55" height="90" fill="#3a4055"/>
      <rect x="285" y="60" width="80" height="160" fill="#2f364b"/>
      <rect x="385" y="105" width="60" height="115" fill="#3a4055"/>
      <rect x="465" y="85" width="70" height="135" fill="#333a50"/>
      <rect x="555" y="120" width="60" height="100" fill="#3a4055"/>
      <rect x="635" y="95" width="75" height="125" fill="#333a50"/>
      <rect x="725" y="130" width="55" height="90" fill="#3a4055"/>
    </g>
    <g class="ct-lights" fill="#ffd98a">
      {Array.from({ length: 60 }).map((_, i) => {
        const buildings = [[46,116,48,96],[126,86,58,126],[216,136,43,76],[291,66,68,146],[391,111,48,101],[471,91,58,121],[561,126,48,86],[641,101,63,111],[731,136,43,76]];
        const b = buildings[i % 9];
        const col = Math.floor(i / 9) % 3;
        const x = b[0] + (col * (b[2] / 3)) + 4;
        const y = b[1] + (Math.floor(i / 27) * 22) + (i % 3) * 20;
        return <rect x={x} y={Math.min(y, 200)} width="7" height="9" rx="1" class={`ct-light ct-d${i % 5}`} />;
      })}
    </g>
    <rect y="208" width="800" height="12" fill="#232838"/>
  </svg>
</div>
)}

{['spring','summer','autumn','winter'].includes(scene) && (
<div class={`scene scene-season scene-${scene}`} aria-hidden="true">
  <div class="season-label">
    {scene === 'spring' && '🌸 春'}
    {scene === 'summer' && '☀️ 夏'}
    {scene === 'autumn' && '🍂 秋'}
    {scene === 'winter' && '❄️ 冬'}
  </div>
  {Array.from({ length: 14 }).map((_, i) => (
    <span class={`particle p${i}`}></span>
  ))}
</div>
)}

<style>
.scene { position: relative; overflow: hidden; border-radius: 12px; margin: 18px 0; }
.scene svg { display: block; width: 100%; height: auto; }

/* 海浪：三层错相位平移 */
.ss-wave { animation: waveMove 7s linear infinite; }
.ss-w2 { animation-duration: 9s; animation-direction: reverse; }
.ss-w3 { animation-duration: 12s; }
@keyframes waveMove { from { transform: translateX(0); } to { transform: translateX(400px); } }
.ss-gull { animation: gullFly 16s linear infinite; }
.ss-gull2 { animation: gullFly 22s linear infinite; animation-delay: -8s; }
@keyframes gullFly { from { transform: translate(0,0); } 50% { transform: translate(400px,-14px); } to { transform: translate(860px,0); } }
.ss-sun { animation: sunGlow 5s ease-in-out infinite alternate; }
@keyframes sunGlow { from { opacity: .8; } to { opacity: 1; } }

/* 爬山 */
.mt-path { stroke-dashoffset: 400; animation: pathDraw 6s ease-in-out infinite alternate; }
@keyframes pathDraw { from { stroke-dashoffset: 400; } to { stroke-dashoffset: 0; } }
.mt-cloud { animation: cloudDrift 14s ease-in-out infinite alternate; }
.mt-cloud2 { animation: cloudDrift 18s ease-in-out infinite alternate-reverse; }
@keyframes cloudDrift { from { transform: translateX(-24px); } to { transform: translateX(30px); } }
.mt-flagcloth { transform-origin: 520px 14px; animation: flagWave 2.4s ease-in-out infinite; }
@keyframes flagWave { 0%,100% { transform: scaleX(1); } 50% { transform: scaleX(.82) skewY(4deg); } }

/* 城市 */
.ct-light { opacity: 0; animation: lightOn 1s ease forwards; }
.ct-d0 { animation-delay: .2s; } .ct-d1 { animation-delay: .9s; } .ct-d2 { animation-delay: 1.6s; }
.ct-d3 { animation-delay: 2.3s; } .ct-d4 { animation-delay: 3s; }
@keyframes lightOn { to { opacity: .95; } }
.ct-stars circle { animation: starTwinkle 3s ease-in-out infinite alternate; }
.ct-stars circle:nth-child(2n) { animation-delay: 1.2s; }
@keyframes starTwinkle { from { opacity: .3; } to { opacity: 1; } }

/* 四季粒子 */
.scene-season { height: 150px; background: var(--paper-dark); }
.season-label { position: absolute; top: 12px; left: 16px; font-size: 22px; opacity: .8; }
.scene-spring { background: linear-gradient(135deg, #fdeef2, #faf6ef); }
.scene-summer { background: linear-gradient(135deg, #e5f2e0, #faf6ef); }
.scene-autumn { background: linear-gradient(135deg, #f7e8d4, #faf6ef); }
.scene-winter { background: linear-gradient(135deg, #e8eef5, #faf6ef); }
.particle { position: absolute; top: -20px; left: 0; animation: fall linear infinite; }
.scene-spring .particle { width: 12px; height: 12px; background: #f5b8c9; border-radius: 60% 0 60% 0; }
.scene-summer .particle { width: 8px; height: 8px; background: #ffd98a; border-radius: 50%; box-shadow: 0 0 8px #ffd98a; }
.scene-autumn .particle { width: 14px; height: 12px; background: #d9a05b; border-radius: 80% 0 80% 0; }
.scene-winter .particle { width: 9px; height: 9px; background: #fff; border-radius: 50%; box-shadow: 0 0 4px #cdd8e4; }
@keyframes fall {
  0% { transform: translate(0, -20px) rotate(0deg); opacity: 0; }
  10% { opacity: 1; }
  100% { transform: translate(var(--dx, 40px), 180px) rotate(300deg); opacity: .6; }
}
</style>
<script>
  // 为四季粒子设置随机轨迹与时长（无 JS 时也有静态展示）
  document.querySelectorAll('.scene-season').forEach(scene => {
    scene.querySelectorAll('.particle').forEach((p, i) => {
      const el = p as HTMLElement;
      el.style.left = `${(i * 7.3 + Math.random() * 5) % 100}%`;
      el.style.setProperty('--dx', `${(Math.random() - 0.3) * 120}px`);
      el.style.animationDuration = `${5 + Math.random() * 6}s`;
      el.style.animationDelay = `${-Math.random() * 8}s`;
    });
  });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ===== 海浪：Canvas 正弦波叠加 + 鼠标涟漪 =====
  document.querySelectorAll<HTMLCanvasElement>('.ss-canvas').forEach(canvas => {
    const ctx = canvas.getContext('2d')!;
    const W = canvas.width, H = canvas.height;
    const ripples: { x: number; y: number; t: number }[] = [];
    let t = 0;

    const toCanvas = (e: MouseEvent | Touch) => {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left) * (W / r.width), y: (e.clientY - r.top) * (H / r.height) };
    };
    canvas.addEventListener('mousemove', e => {
      const p = toCanvas(e);
      ripples.push({ x: p.x, y: p.y, t: 0 });
      if (ripples.length > 12) ripples.shift();
    }, { passive: true });
    canvas.addEventListener('touchmove', e => {
      const p = toCanvas(e.touches[0]);
      ripples.push({ x: p.x, y: p.y, t: 0 });
      if (ripples.length > 12) ripples.shift();
    }, { passive: true });

    function rippleOffset(x: number, baseY: number): number {
      let off = 0;
      for (const r of ripples) {
        const d = Math.abs(x - r.x);
        const age = r.t;
        off += Math.sin(d * 0.09 - age * 0.25) * 7 * Math.exp(-d * 0.012) * Math.exp(-age * 0.03);
      }
      return off;
    }

    const waves = [
      { base: 22, amp: 6, len: 0.018, speed: 0.020, color: 'rgba(255,255,255,.55)', width: 3 },
      { base: 52, amp: 7, len: 0.014, speed: -0.014, color: 'rgba(255,255,255,.38)', width: 2.5 },
      { base: 82, amp: 8, len: 0.011, speed: 0.010, color: 'rgba(255,255,255,.24)', width: 2 },
    ];

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const w of waves) {
        ctx.beginPath();
        ctx.strokeStyle = w.color;
        ctx.lineWidth = w.width;
        for (let x = 0; x <= W; x += 4) {
          const y = w.base + Math.sin(x * w.len + t * w.speed * 60) * w.amp + rippleOffset(x, w.base);
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      ripples.forEach(r => r.t += 1);
      for (let i = ripples.length - 1; i >= 0; i--) if (ripples[i].t > 90) ripples.splice(i, 1);
      t += 0.016;
      if (!reduced) requestAnimationFrame(draw);
    }
    draw(); // reduced-motion 时画一帧静态
  });

  // ===== 爬山：登山小人随页面滚动沿山径上移 =====
  document.querySelectorAll('.scene-mountain').forEach(scene => {
    const trail = scene.querySelector<SVGPathElement>('#mt-trail, .mt-path');
    const climber = scene.querySelector<SVGGElement>('.mt-climber');
    if (!trail || !climber) return;
    const total = trail.getTotalLength();
    const setPos = (ratio: number) => {
      const p = trail.getPointAtLength(total * Math.min(Math.max(ratio, 0), 1));
      climber.setAttribute('transform', `translate(${p.x}, ${p.y})`);
    };
    setPos(0.05);
    if (reduced) { setPos(1); return; }
    const onScroll = () => {
      const r = scene.getBoundingClientRect();
      const vh = window.innerHeight;
      // 场景从进入视野底部到到达视野中部，映射为登山进度
      const ratio = (vh - r.top) / (vh * 0.85);
      setPos(ratio);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
