---
import '../styles/global.css';
import { site } from '../config';

interface Props { title?: string; active?: string; }
const { title = '我们的恋爱手账', active = '' } = Astro.props;
const path = Astro.url.pathname;

// 今天是否是纪念日（月日相同）
const now = new Date();
const md = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
const todayAnniversary = site.anniversary.find(a => a.date.slice(5) === md);
const anniversaryYears = todayAnniversary ? now.getFullYear() - Number(todayAnniversary.date.slice(0, 4)) : 0;
const links = [
  { href: '/', label: '首页' },
  { href: '/timeline/', label: '时间轴' },
  { href: '/gallery/', label: '照片墙' },
  { href: '/diary/', label: '日记留言' },
  { href: '/wishes/', label: '愿望清单' },
  { href: '/map/', label: '足迹地图' },
  { href: '/year/', label: '年度手账' },
];
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · {site.coupleName}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💌</text></svg>" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" />
</head>
<body>
  {path === '/' && (
    <div class="book-cover" id="book-cover" hidden>
      <div class="book" id="book">
        <div class="book-spine"></div>
        <div class="book-front">
          <div class="book-deco">❦</div>
          <div class="book-title">恋爱手账</div>
          <div class="book-names">{site.coupleName}</div>
          <div class="book-date">始于 {site.startDate.replaceAll('-', '.')}</div>
          <div class="book-open-hint">轻点封面，翻开我们</div>
        </div>
      </div>
    </div>
  )}

  {todayAnniversary && (
    <div class="anniversary-banner" id="anniversary-banner">
      🎉 今天是「{todayAnniversary.title}」{anniversaryYears > 0 ? `${anniversaryYears} 周年` : '纪念日'}，快乐！
      <button class="anniversary-close" aria-label="关闭" onclick="this.parentElement.remove()">×</button>
    </div>
  )}

  <div class="night-lamp" aria-hidden="true"></div>

  <!-- 书桌两侧装饰：仅宽屏显示 -->
  <div class="desk desk-left" aria-hidden="true">
    <div class="desk-tape desk-tape-v"></div>
    <div class="desk-vertical-text">日 拱 一 卒</div>
    <div class="desk-note" id="desk-note">点我翻一句 ↻</div>
    <div class="plane-wrap" id="plane-wrap">
      <svg class="desk-plane" viewBox="0 0 120 100" width="110" height="92">
        <path d="M10 55 L105 15 L60 85 L48 60 Z" fill="none" stroke="#b6a88f" stroke-width="2.2" stroke-linejoin="round"/>
        <path d="M48 60 L105 15" fill="none" stroke="#b6a88f" stroke-width="2"/>
        <path d="M10 55 L48 60 L60 85" fill="none" stroke="#b6a88f" stroke-width="1.4" opacity=".6"/>
        <path d="M15 88 Q 40 78 66 88" fill="none" stroke="#cfc2ab" stroke-width="1.6" stroke-dasharray="4 5"/>
      </svg>
    </div>
  </div>
  <div class="desk desk-right" aria-hidden="true">
    <div class="desk-tape desk-tape-v"></div>
    <div class="stamp-wrap" id="stamp-wrap" role="button" tabindex="0" aria-label="盖一个纪念章">
      <svg class="desk-stamp" viewBox="0 0 120 140" width="104" height="122">
        <rect x="14" y="10" width="66" height="80" rx="4" fill="#fffdf8" stroke="#cfc2ab" stroke-width="2" stroke-dasharray="5 4"/>
        <path d="M47 66 C40 58 30 50 30 40 A11 11 0 0 1 47 32 A11 11 0 0 1 64 40 C64 50 54 58 47 66Z" fill="none" stroke="#d47b5c" stroke-width="2.2"/>
        <circle cx="86" cy="86" r="30" fill="none" stroke="#b6a88f" stroke-width="1.8"/>
        <circle cx="86" cy="86" r="23" fill="none" stroke="#b6a88f" stroke-width="1"/>
        <text x="86" y="82" text-anchor="middle" font-size="11" fill="#b6a88f" font-family="KaiTi,serif">我们的</text>
        <text x="86" y="97" text-anchor="middle" font-size="11" fill="#b6a88f" font-family="KaiTi,serif">纪念日</text>
        <path d="M20 118 Q 55 108 100 118" fill="none" stroke="#cfc2ab" stroke-width="1.6"/>
      </svg>
      <span class="stamp-hint">点我盖章</span>
    </div>
    <div class="flower-wrap" id="flower-wrap">
      <svg class="desk-flower" viewBox="0 0 100 130" width="86" height="112">
        <path d="M50 125 Q 46 80 52 40" fill="none" stroke="#8aa87e" stroke-width="2.4"/>
        <path d="M50 95 Q 30 88 26 70 Q 46 74 50 95Z" fill="#a8c29c" opacity=".8"/>
        <path d="M50 80 Q 72 76 76 58 Q 56 62 50 80Z" fill="#a8c29c" opacity=".7"/>
        <circle cx="52" cy="32" r="9" fill="#f0b8c6"/>
        <circle cx="42" cy="38" r="8" fill="#f5c6d4"/>
        <circle cx="62" cy="38" r="8" fill="#f5c6d4"/>
        <circle cx="52" cy="40" r="5" fill="#c9a44c"/>
      </svg>
    </div>
    <div id="stamp-zone"></div>
  </div>
  <nav class="nav">
    <div class="container nav-inner">
      <a class="nav-brand" href="/">📖 恋爱手账</a>
      <button class="nav-toggle" aria-label="菜单" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
      <div class="nav-links">
        {links.map(l => <a href={l.href} class={path === l.href ? 'active' : ''}>{l.label}</a>)}
        <span class="nav-ink" id="nav-ink" aria-hidden="true">
          <svg viewBox="0 0 100 12" preserveAspectRatio="none"><path d="M2 8 Q 30 2 55 7 T 98 5" stroke="#d47b5c" stroke-width="2.5" fill="none" stroke-linecap="round" opacity=".65"/></svg>
        </span>
      </div>
    </div>
  </nav>
  <main class="container">
    <slot />
  </main>
  <footer class="footer">
    <div class="container">把日子过成展品 · {site.coupleName} ❤</div>
  </footer>

  {site.music.src && (
    <div class="music-player" id="music-player">
      <audio id="bg-music" src={site.music.src} loop preload="none"></audio>
      <button class="music-btn" id="music-btn" aria-label="播放/暂停音乐" title={site.music.title}>
        <span class="music-note">♪</span>
      </button>
      <span class="music-title">{site.music.title}</span>
    </div>
  )}

  <script>
    import '../scripts/cursor-magic';
    import { confetti } from '../scripts/confetti';
    import { initDesk } from '../scripts/desk-interactions';
    import { initButtonEffects } from '../scripts/button-effects';
    import { initNavInk } from '../scripts/nav-ink';
    import { initNavPlayful } from '../scripts/nav-playful';
    initDesk();
    initButtonEffects();
    initNavInk();
    initNavPlayful();

    // 开屏翻书：每个会话只出现一次
    const cover = document.getElementById('book-cover');
    if (cover) {
      if (!sessionStorage.getItem('loverecord-book-opened')) {
        cover.hidden = false;
        document.body.style.overflow = 'hidden';
        document.getElementById('book')!.addEventListener('click', () => {
          cover.classList.add('opening');
          sessionStorage.setItem('loverecord-book-opened', '1');
          document.body.style.overflow = '';
          setTimeout(() => cover.remove(), 900);
        }, { once: true });
      } else {
        cover.remove();
      }
    }

    // 纪念日彩带
    if (document.getElementById('anniversary-banner')) {
      setTimeout(() => confetti(100), 600);
    }

    // 日夜灯光：18:00 - 次日 6:00 进入暖灯模式
    const hour = new Date().getHours();
    if (hour >= 18 || hour < 6) document.body.classList.add('night');
  </script>
</body>
  <script>
    const audio = document.getElementById('bg-music') as HTMLAudioElement | null;
    const btn = document.getElementById('music-btn');
    const player = document.getElementById('music-player');
    if (audio && btn && player) {
      // 音频文件不存在时隐藏按钮
      audio.addEventListener('error', () => { player.style.display = 'none'; });
      btn.addEventListener('click', () => {
        if (audio.paused) {
          audio.play().then(() => player.classList.add('playing'))
            .catch(() => { player.style.display = 'none'; });
        } else {
          audio.pause();
          player.classList.remove('playing');
        }
      });
    }
  </script>
</body>
</html>
