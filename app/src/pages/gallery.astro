---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('timeline'))
  .filter(m => m.data.image)
  .map(m => ({ image: m.data.image, alt: m.data.alt, date: m.data.date, title: m.data.title }));
---
<Base title="照片墙" active="/gallery/">
  <h1 class="hand-title">照片墙</h1>
  <p class="hand-sub">每一张背后都有一天</p>

  <div class="admin-bar">
    <button class="btn ghost" id="admin-toggle">🔐 管理</button>
    <button class="btn" id="admin-add" hidden>＋ 添加照片</button>
  </div>

  <div class="gallery" id="gallery"></div>

  <div class="lightbox" id="lightbox" hidden>
    <img id="lightbox-img" alt="放大预览" />
  </div>
</Base>

<script is:inline define:vars={{ photos }}>
  window.__STATIC_PHOTOS = photos;
</script>

<script>
  import { fetchOnlineMemories, imagesOf } from '../scripts/memories-shared';
  import { isLoggedIn, askPassword, openMemoryForm } from '../scripts/memory-admin';

  const galleryEl = document.getElementById('gallery')!;
  const box = document.getElementById('lightbox')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const adminToggle = document.getElementById('admin-toggle') as HTMLButtonElement;
  const adminAdd = document.getElementById('admin-add') as HTMLButtonElement;

  async function renderAll() {
    const online = await fetchOnlineMemories();
    const onlinePhotos = online.flatMap(m =>
      imagesOf(m).map(url => ({ image: url, alt: m.alt || m.title, date: m.date, title: m.title })));
    const all = [...((window as any).__STATIC_PHOTOS || []), ...onlinePhotos]
      .sort((a, b) => b.date.localeCompare(a.date));

    galleryEl.innerHTML = all.map((p, i) => `
      <figure class="polaroid tape develop collage-item c${i % 6} ${i % 2 ? 'tilt-r' : 'tilt-l'}" data-full="${p.image}">
        <div class="photo-frame">
          <img src="${p.image}" alt="${p.alt}" loading="lazy" />
          <div class="develop-veil" aria-hidden="true"></div>
        </div>
        <figcaption>${p.date} · ${p.title}</figcaption>
      </figure>
      ${i % 6 === 3 ? `<div class="collage-note c-note"><span>✎ 这些日子<br>都值得</span><svg viewBox="0 0 60 60" width="44" height="44"><path d="M30 50 C20 40 8 32 8 20 A11 11 0 0 1 30 12 A11 11 0 0 1 52 20 C52 32 40 40 30 50Z" fill="none" stroke="#d47b5c" stroke-width="2.4"/></svg></div>` : ''}
    `).join('');

    galleryEl.querySelectorAll('figure').forEach(f => {
      f.addEventListener('click', () => {
        img.src = (f as HTMLElement).dataset.full || '';
        box.hidden = false;
      });
    });
    observeDevelop();
  }

  const io = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting) {
        const el = en.target as HTMLElement;
        setTimeout(() => el.classList.add('developed'), Math.random() * 400);
        io.unobserve(el);
      }
    });
  }, { threshold: 0.25 });
  function observeDevelop() {
    galleryEl.querySelectorAll('.develop').forEach(el => io.observe(el));
  }

  box.addEventListener('click', () => { box.hidden = true; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') box.hidden = true; });

  adminToggle.addEventListener('click', () => {
    if (isLoggedIn()) {
      adminAdd.hidden = !adminAdd.hidden;
    } else {
      askPassword(() => { adminAdd.hidden = false; });
    }
  });
  adminAdd.addEventListener('click', () => openMemoryForm(null, { onChanged: renderAll }));
  if (isLoggedIn()) adminAdd.hidden = false;

  renderAll();
</script>

<style is:global>
.gallery {
  display: grid; grid-template-columns: repeat(12, 1fr);
  gap: 30px 26px; padding: 16px 4px; align-items: start;
}
.gallery figure { cursor: zoom-in; margin: 0; }
/* 拼贴节奏：六种跨度与位置，像手账跨页 */
.collage-item.c0 { grid-column: span 5; }
.collage-item.c1 { grid-column: span 4; margin-top: 34px; }
.collage-item.c2 { grid-column: span 3; margin-top: 10px; }
.collage-item.c3 { grid-column: span 4; }
.collage-item.c4 { grid-column: span 5; margin-top: 26px; }
.collage-item.c5 { grid-column: span 3; margin-top: 6px; }
/* 穿插的手写便签 */
.collage-note {
  grid-column: span 3; align-self: center; justify-self: center;
  text-align: center; color: var(--ink-soft);
  font-family: var(--font-hand); font-size: 19px; line-height: 1.7;
  transform: rotate(-5deg);
  background: #f7ecc8; padding: 22px 16px 14px;
  border-radius: 2px; box-shadow: 2px 4px 0 rgba(61,58,52,.08);
  position: relative;
}
.collage-note::before {
  content: ''; position: absolute; top: -10px; left: 50%; transform: translateX(-50%) rotate(-3deg);
  width: 64px; height: 20px; background: var(--tape); opacity: .85;
}
.collage-note svg { margin-top: 8px; }

@media (max-width: 900px) {
  .gallery { grid-template-columns: repeat(6, 1fr); gap: 24px 18px; }
  .collage-item.c0, .collage-item.c4 { grid-column: span 4; }
  .collage-item.c1, .collage-item.c2, .collage-item.c3, .collage-item.c5 { grid-column: span 3; margin-top: 0; }
  .collage-note { grid-column: span 2; font-size: 16px; }
}
@media (max-width: 560px) {
  .gallery { grid-template-columns: repeat(2, 1fr); gap: 20px 14px; }
  .collage-item, .collage-item[class*="c"] { grid-column: span 1; margin-top: 0; }
  .collage-note { grid-column: span 2; }
}
.lightbox {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(30, 26, 20, 0.85);
  display: flex; align-items: center; justify-content: center;
  cursor: zoom-out; padding: 30px;
}
.lightbox[hidden] { display: none; }
.lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 6px; box-shadow: 0 10px 50px rgba(0,0,0,.5); }

.photo-frame { position: relative; overflow: hidden; border-radius: 2px; }
.photo-frame img { transition: filter 2.2s ease .3s; }
.develop .photo-frame img { filter: sepia(.5) brightness(1.5) contrast(.35) blur(2px); }
.develop-veil {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, #f3ecdf 0%, #ece0c9 60%, #e6d7ba 100%);
  transform-origin: top;
}
.develop.developed .photo-frame img { filter: sepia(0) brightness(1) contrast(1) blur(0); }
.develop.developed .develop-veil { animation: veilDrain 1.8s cubic-bezier(.4,0,.2,1) forwards; }
@keyframes veilDrain {
  0% { transform: scaleY(1); opacity: 1; }
  70% { opacity: .9; }
  100% { transform: scaleY(0); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .develop .photo-frame img { filter: none; }
  .develop-veil { display: none; }
}

.admin-bar { display: flex; justify-content: center; gap: 14px; margin-bottom: 26px; }
.admin-modal {
  position: fixed; inset: 0; z-index: 200; overflow-y: auto;
  background: rgba(30,26,20,.5); display: flex; align-items: flex-start; justify-content: center;
  padding: 40px 16px;
}
.admin-modal-card { width: 100%; max-width: 560px; }
.admin-row { display: flex; gap: 14px; }
.admin-photo-preview { margin-top: 10px; display: flex; align-items: center; gap: 14px; }
.admin-photo-preview[hidden] { display: none; }
.admin-photo-preview img { width: 110px; border-radius: 6px; }
.admin-remove-photo { background: none; border: none; color: #c0615a; cursor: pointer; font-size: 14px; }
.admin-form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; }
.admin-form-error { color: #c0615a; margin-top: 12px; }
</style>
