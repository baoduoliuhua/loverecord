---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('timeline'))
  .filter(m => m.data.image)
  .map(m => ({ image: m.data.image, alt: m.data.alt, date: m.data.date, title: m.data.title, sortDate: m.data.sortDate, city: m.data.city || '' }));
---
<Base title="照片墙" active="/gallery/">
  <h1 class="hand-title">照片墙</h1>
  <p class="hand-sub">每一张背后都有一天</p>

  <div class="admin-bar">
    <button class="btn ghost" id="admin-toggle">🔐 管理</button>
    <button class="btn" id="admin-add" hidden>＋ 添加照片</button>
    <button class="btn ghost" id="batch-toggle" hidden>☑ 批量管理</button>
  </div>

  <div class="batch-bar" id="batch-bar" hidden>
    <label><input type="checkbox" id="batch-all" /> 全选</label>
    <span id="batch-count">已选 0 张</span>
    <button class="btn" id="batch-delete">删除选中照片</button>
    <button class="btn ghost" id="batch-done">完成</button>
  </div>

  <div class="view-tabs" id="view-tabs">
    <button class="view-tab active" data-view="collage">拼贴</button>
    <button class="view-tab" data-view="time">按时间</button>
    <button class="view-tab" data-view="place">按地点</button>
  </div>

  <div class="gallery" id="gallery"></div>
  <div id="grouped" hidden></div>

  <div class="lightbox" id="lightbox" hidden>
    <img id="lightbox-img" alt="放大预览" />
  </div>
</Base>

<script is:inline define:vars={{ photos }}>
  window.__STATIC_PHOTOS = photos;
</script>

<script>
  import { fetchOnlineMemories, imagesOf, isVideo, removeImages } from '../scripts/memories-shared';
  import { isLoggedIn, askPassword, openMemoryForm } from '../scripts/memory-admin';

  const galleryEl = document.getElementById('gallery')!;
  const box = document.getElementById('lightbox')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const adminToggle = document.getElementById('admin-toggle') as HTMLButtonElement;
  const adminAdd = document.getElementById('admin-add') as HTMLButtonElement;

  let allPhotos: any[] = [];
  let currentView = 'collage';
  let batchMode = false;

  async function renderAll() {
    const online = await fetchOnlineMemories();
    const onlinePhotos = online.flatMap(m =>
      imagesOf(m).map(url => ({ image: url, alt: m.alt || m.title, date: m.date, title: m.title, sortDate: m.sortDate, city: m.city || '', online: true })));
    allPhotos = [...((window as any).__STATIC_PHOTOS || []), ...onlinePhotos]
      .sort((a, b) => b.sortDate.localeCompare(a.sortDate));
    renderView();
  }

  function photoCard(p: any, i: number) {
    const check = batchMode && p.online
      ? `<label class="batch-check-label"><input type="checkbox" class="batch-check" data-url="${p.image}" /></label>` : '';
    if (isVideo(p.image)) {
      return `<div class="collage-item c${i % 6} gallery-video">${check}
        <video src="${p.image}" controls playsinline preload="metadata"></video>
        <div class="gallery-video-caption">🎬 ${p.date} · ${p.title}</div>
      </div>`;
    }
    return `<figure class="polaroid tape develop collage-item c${i % 6} ${i % 2 ? 'tilt-r' : 'tilt-l'}" data-full="${p.image}">${check}
      <div class="photo-frame">
        <img src="${p.image}" alt="${p.alt}" loading="lazy" />
        <div class="develop-veil" aria-hidden="true"></div>
      </div>
      <figcaption>${p.date} · ${p.title}</figcaption>
    </figure>`;
  }

  function renderView() {
    const isCollage = currentView === 'collage';
    (galleryEl as HTMLElement).hidden = !isCollage;
    (groupedEl as HTMLElement).hidden = isCollage;
    if (isCollage) {
      galleryEl.innerHTML = allPhotos.map((p, i) => photoCard(p, i) + (i % 6 === 3 ? `<div class="collage-note c-note"><span>✎ 这些日子<br>都值得</span><svg viewBox="0 0 60 60" width="44" height="44"><path d="M30 50 C20 40 8 32 8 20 A11 11 0 0 1 30 12 A11 11 0 0 1 52 20 C52 32 40 40 30 50Z" fill="none" stroke="#d47b5c" stroke-width="2.4"/></svg></div>` : '')).join('');
    } else {
      const groups = new Map<string, any[]>();
      for (const p of allPhotos) {
        const key = currentView === 'time'
          ? `${p.sortDate.slice(0, 4)} 年 ${Number(p.sortDate.slice(5, 7))} 月`
          : (p.city || '未标记地点');
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key)!.push(p);
      }
      groupedEl.innerHTML = [...groups.entries()].map(([key, list]) => `
        <section class="photo-group">
          <h3 class="group-title">${key}<span class="group-count">${list.length} 张</span></h3>
          <div class="group-grid">
            ${list.map((p, i) => photoCard(p, i)).join('')}
          </div>
        </section>`).join('');
    }
    bindLightbox();
    observeDevelop();
  }

  function bindLightbox() {
    document.querySelectorAll('#gallery figure, #grouped figure').forEach(f => {
      f.addEventListener('click', e => {
        if (batchMode) {
          // 批量模式：点击照片即勾选
          if ((e.target as HTMLElement).classList.contains('batch-check')) return;
          const c = f.querySelector<HTMLInputElement>('.batch-check');
          if (c) { c.checked = !c.checked; refreshBatchCount(); }
          return;
        }
        img.src = (f as HTMLElement).dataset.full || '';
        box.hidden = false;
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.view-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.view-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentView = tab.dataset.view!;
      renderView();
    });
  });

  const io = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting) {
        const el = en.target as HTMLElement;
        setTimeout(() => el.classList.add('developed'), Math.random() * 400);
        io.unobserve(el);
      }
    });
  }, { threshold: 0.25 });
  function observeDevelop() {
    document.querySelectorAll('#gallery .develop, #grouped .develop').forEach(el => io.observe(el));
  }

  box.addEventListener('click', () => { box.hidden = true; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') box.hidden = true; });

  adminToggle.addEventListener('click', () => {
    if (isLoggedIn()) {
      adminAdd.hidden = !adminAdd.hidden;
      batchToggle.hidden = adminAdd.hidden;
    } else {
      askPassword(() => { adminAdd.hidden = false; batchToggle.hidden = false; });
    }
  });
  adminAdd.addEventListener('click', () => openMemoryForm(null, { onChanged: renderAll }));
  if (isLoggedIn()) { adminAdd.hidden = false; batchToggle.hidden = false; }

  // ===== 批量管理 =====
  const batchToggle = document.getElementById('batch-toggle') as HTMLButtonElement;
  const batchBar = document.getElementById('batch-bar')!;
  const batchAll = document.getElementById('batch-all') as HTMLInputElement;
  const batchCount = document.getElementById('batch-count')!;

  function selectedUrls(): string[] {
    return [...document.querySelectorAll<HTMLInputElement>('.batch-check:checked')].map(c => c.dataset.url!);
  }
  function refreshBatchCount() {
    batchCount.textContent = `已选 ${selectedUrls().length} 张`;
  }
  batchToggle.addEventListener('click', () => {
    batchMode = !batchMode;
    (batchBar as HTMLElement).hidden = !batchMode;
    batchToggle.textContent = batchMode ? '退出批量' : '☑ 批量管理';
    renderView();
  });
  document.getElementById('batch-done')!.addEventListener('click', () => {
    batchMode = false;
    (batchBar as HTMLElement).hidden = true;
    batchToggle.textContent = '☑ 批量管理';
    renderView();
  });
  batchAll.addEventListener('change', () => {
    document.querySelectorAll<HTMLInputElement>('.batch-check').forEach(c => { c.checked = batchAll.checked; });
    refreshBatchCount();
  });
  document.addEventListener('change', e => {
    if ((e.target as HTMLElement).classList.contains('batch-check')) refreshBatchCount();
  });
  document.getElementById('batch-delete')!.addEventListener('click', async () => {
    const urls = selectedUrls();
    if (!urls.length) { alert('先勾选要删除的照片'); return; }
    if (!confirm(`确定从回忆中移除选中的 ${urls.length} 张照片吗？`)) return;
    try {
      await removeImages(urls);
      batchAll.checked = false;
      refreshBatchCount();
      renderAll();
    } catch { alert('删除失败，请重试'); }
  });

  renderAll();
</script>

<style is:global>
/* 视图切换 */
.view-tabs { display: flex; justify-content: center; gap: 4px; margin-bottom: 28px; border-bottom: 1.5px solid #e8dcc4; padding-bottom: 0; }
.view-tab {
  padding: 8px 26px; background: none; border: none; cursor: pointer;
  font-family: var(--font-hand); font-size: 17px; color: var(--ink-soft);
  border-bottom: 3px solid transparent; margin-bottom: -1.5px;
  transition: color .2s;
}
.view-tab:hover { color: var(--ink); }
.view-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
/* 分组视图 */
.photo-group { margin-bottom: 44px; }
.group-title {
  font-size: 22px; margin-bottom: 20px; display: flex; align-items: baseline; gap: 14px;
  border-bottom: 2px dashed #e3d9c8; padding-bottom: 10px;
}
.group-count { font-size: 14px; color: var(--ink-soft); font-weight: 400; }
.group-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; }
.group-grid .collage-item { grid-column: auto !important; margin-top: 0 !important; }
.group-grid .gallery-video { grid-column: auto; }

.gallery {
  display: grid; grid-template-columns: repeat(12, 1fr);
  gap: 30px 26px; padding: 16px 4px; align-items: start;
}
.gallery figure { cursor: zoom-in; margin: 0; }
/* 拼贴节奏：六种跨度与位置，像手账跨页 */
.collage-item.c0 { grid-column: span 5; }
.collage-item.c1 { grid-column: span 4; margin-top: 34px; }
.collage-item.c2 { grid-column: span 3; margin-top: 10px; }
.collage-item.c3 { grid-column: span 4; }
.collage-item.c4 { grid-column: span 5; margin-top: 26px; }
.collage-item.c5 { grid-column: span 3; margin-top: 6px; }
/* 穿插的手写便签 */
.collage-note {
  grid-column: span 3; align-self: center; justify-self: center;
  text-align: center; color: var(--ink-soft);
  font-family: var(--font-hand); font-size: 19px; line-height: 1.7;
  transform: rotate(-5deg);
  background: #f7ecc8; padding: 22px 16px 14px;
  border-radius: 2px; box-shadow: 2px 4px 0 rgba(61,58,52,.08);
  position: relative;
}
.collage-note::before {
  content: ''; position: absolute; top: -10px; left: 50%; transform: translateX(-50%) rotate(-3deg);
  width: 64px; height: 20px; background: var(--tape); opacity: .85;
}
.collage-note svg { margin-top: 8px; }

@media (max-width: 900px) {
  .gallery { grid-template-columns: repeat(6, 1fr); gap: 24px 18px; }
  .collage-item.c0, .collage-item.c4 { grid-column: span 4; }
  .collage-item.c1, .collage-item.c2, .collage-item.c3, .collage-item.c5 { grid-column: span 3; margin-top: 0; }
  .collage-note { grid-column: span 2; font-size: 16px; }
}
@media (max-width: 560px) {
  .gallery { grid-template-columns: repeat(2, 1fr); gap: 20px 14px; }
  .collage-item, .collage-item[class*="c"] { grid-column: span 1; margin-top: 0; }
  .collage-note { grid-column: span 2; }
}
.lightbox {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(30, 26, 20, 0.85);
  display: flex; align-items: center; justify-content: center;
  cursor: zoom-out; padding: 30px;
}
.lightbox[hidden] { display: none; }
.lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 6px; box-shadow: 0 10px 50px rgba(0,0,0,.5); }

.photo-frame { position: relative; overflow: hidden; border-radius: 2px; }
.photo-frame img { transition: filter 2.2s ease .3s; }
.develop .photo-frame img { filter: sepia(.5) brightness(1.5) contrast(.35) blur(2px); }
.develop-veil {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, #f3ecdf 0%, #ece0c9 60%, #e6d7ba 100%);
  transform-origin: top;
}
.develop.developed .photo-frame img { filter: sepia(0) brightness(1) contrast(1) blur(0); }
.develop.developed .develop-veil { animation: veilDrain 1.8s cubic-bezier(.4,0,.2,1) forwards; }
@keyframes veilDrain {
  0% { transform: scaleY(1); opacity: 1; }
  70% { opacity: .9; }
  100% { transform: scaleY(0); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .develop .photo-frame img { filter: none; }
  .develop-veil { display: none; }
}

.admin-bar { display: flex; justify-content: center; gap: 14px; margin-bottom: 26px; }
.admin-modal {
  position: fixed; inset: 0; z-index: 200; overflow-y: auto;
  background: rgba(30,26,20,.5); display: flex; align-items: flex-start; justify-content: center;
  padding: 40px 16px;
}
.admin-modal-card { width: 100%; max-width: 560px; }
.admin-row { display: flex; gap: 14px; }
.admin-photo-preview { margin-top: 10px; display: flex; align-items: center; gap: 14px; }
.admin-photo-preview[hidden] { display: none; }
.admin-photo-preview img { width: 110px; border-radius: 6px; }
.admin-remove-photo { background: none; border: none; color: #c0615a; cursor: pointer; font-size: 14px; }
.admin-form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; }
.admin-form-error { color: #c0615a; margin-top: 12px; }
</style>
