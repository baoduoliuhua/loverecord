---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import LoveLetter from '../components/LoveLetter.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';

const memories = (await getCollection('timeline'))
  .sort((a, b) => b.data.sortDate.localeCompare(a.data.sortDate));
const latest = memories.slice(0, 3);
const allMemories = memories.map(m => ({
  title: m.data.title, date: m.data.date, sortDate: m.data.sortDate,
  image: m.data.image || '', alt: m.data.alt || '', body: (m.body || '').trim(),
}));

const today = new Date();
const days = Math.floor((today.getTime() - new Date(site.startDate + 'T00:00:00').getTime()) / 86400000) + 1;

// 下一个纪念日
const upcoming = site.anniversary.map(a => {
  const d = new Date(a.date);
  let next = new Date(today.getFullYear(), d.getMonth(), d.getDate());
  if (next < today) next = new Date(today.getFullYear() + 1, d.getMonth(), d.getDate());
  return { ...a, left: Math.ceil((next.getTime() - today.getTime()) / 86400000), next };
}).sort((a, b) => a.left - b.left)[0];

// 当前季节氛围
const m = today.getMonth() + 1;
const season = m >= 3 && m <= 5 ? 'spring' : m >= 6 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
---
<Base title="首页" active="/">
  <section class="hero reveal">
    <p class="hero-sub">这里陈列着我们最重要的东西</p>
    <h1 class="hero-title">{site.coupleName}</h1>
    <p class="daily-quote" id="daily-quote"></p>
    <div class="days-card">
      <div class="days-label">今天是我们在一起的</div>
      <div class="days-number">第 <span class="heartbeat-num">{days}</span> 天
        <svg class="heartbeat-icon" viewBox="0 0 32 30" width="34" height="32" aria-hidden="true"><path d="M16 28 C8 20 1 14 1 8 A7.5 7.5 0 0 1 16 5 A7.5 7.5 0 0 1 31 8 C31 14 24 20 16 28Z" fill="#d47b5c"/></svg>
      </div>
      <div class="days-date">始于 {site.startDate.replaceAll('-', '.')}</div>
    </div>
    {upcoming && (
      <p class="upcoming" id="upcoming" data-fallback={upcoming.left}>📅 距离「{upcoming.title}」纪念日还有
        <span class="flip-clock" data-value={upcoming.left} aria-label={`${upcoming.left} 天`}></span> 天
      </p>
    )}
    {!upcoming && <p class="upcoming" id="upcoming" hidden></p>}
    <div class="miss-wrap">
      <button class="miss-btn" id="miss-btn" aria-label="想你了">
        <svg viewBox="0 0 32 30" width="26" height="24"><path d="M16 28 C8 20 1 14 1 8 A7.5 7.5 0 0 1 16 5 A7.5 7.5 0 0 1 31 8 C31 14 24 20 16 28Z" fill="currentColor"/></svg>
        想你了
      </button>
      <span class="miss-count" id="miss-count"></span>
      <button class="settings-btn" id="settings-btn" title="站点设置" aria-label="站点设置">⚙</button>
    </div>
  </section>

  <Scene scene={season} />

  <section id="on-this-day" hidden></section>

  <LoveLetter />

  <h2 class="section-title">最新回忆 <a class="more" href="/timeline/">进入展馆 →</a></h2>
  <div class="memory-grid">
    {latest.map((item, i) => (
      <a href="/timeline/" class={`polaroid tape ${item.data.tilt}`} style={`animation-delay:${i * 0.12}s`}>
        {item.data.image
          ? <img src={item.data.image} alt={item.data.alt} loading="lazy" />
          : <div class="no-photo">{item.data.scene === 'seaside' ? '🌊' : item.data.scene === 'mountain' ? '⛰️' : item.data.scene === 'city' ? '🌃' : '🌸'}</div>}
        <figcaption>{item.data.date} · {item.data.title}</figcaption>
      </a>
    ))}
  </div>
</Base>

<style is:global>
.hero { text-align: center; padding: 48px 0 8px; }
.hero-sub { color: var(--ink-soft); font-size: 17px; }
.hero-title { font-size: clamp(34px, 6vw, 52px); margin: 10px 0 30px; }
.days-card {
  display: inline-block; padding: 28px 56px;
  background: #fffdf8; border: 2px solid #ece2d0; border-radius: 20px;
  box-shadow: 3px 5px 0 rgba(61,58,52,.07);
  transform: rotate(-.6deg);
}
.days-label { color: var(--ink-soft); font-size: 16px; }
.days-number { font-size: 30px; margin: 6px 0; }
.days-number span { font-size: 64px; color: var(--accent); font-weight: 700; padding: 0 6px; }
/* 心跳：数字与爱心同步双跳（模拟真实心跳 lub-dub） */
.heartbeat-num { display: inline-block; animation: heartbeat 1.6s ease-in-out infinite; transform-origin: center; }
.heartbeat-icon { display: inline-block; vertical-align: middle; margin-left: 10px; animation: heartbeat 1.6s ease-in-out infinite; transform-origin: center; }
@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  12% { transform: scale(1.12); }
  24% { transform: scale(1); }
  36% { transform: scale(1.08); }
  52% { transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) { .heartbeat-num, .heartbeat-icon { animation: none; } }
.days-date { color: var(--ink-soft); font-size: 14px; }
.upcoming { margin-top: 22px; font-size: 17px; }
.upcoming strong { color: var(--accent); font-size: 22px; }
/* 翻牌数字 */
.flip-clock { display: inline-flex; gap: 4px; vertical-align: middle; margin: 0 4px; }
.flip-digit {
  position: relative; width: 34px; height: 46px;
  background: #fffdf8; border: 1.5px solid #e0d5c2; border-radius: 6px;
  font-size: 30px; font-weight: 700; color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 3px 0 rgba(61,58,52,.08);
  transform-style: preserve-3d;
}
.flip-digit::after { /* 翻牌中缝线 */
  content: ''; position: absolute; left: 0; right: 0; top: 50%;
  border-top: 1.5px solid #e8dcc4;
}
.flip-digit.flipping { animation: flipIn .32s ease; }
@keyframes flipIn {
  0% { transform: rotateX(-88deg); opacity: .3; }
  100% { transform: rotateX(0); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .flip-digit.flipping { animation: none; } }

/* 那年今日 */
#on-this-day { margin: 34px 0 6px; }
#on-this-day[hidden] { display: none; }
.otd-card { display: block; transition: transform .25s, box-shadow .25s; }
.otd-card:hover { transform: translateY(-4px) rotate(-.4deg); box-shadow: 4px 10px 0 rgba(61,58,52,.08); }
.otd-label { color: var(--accent); font-size: 15px; margin-bottom: 14px; letter-spacing: .06em; }
.otd-body { display: flex; gap: 22px; align-items: flex-start; }
.otd-img { width: 150px; border-radius: 8px; flex: none; transform: rotate(-2deg); box-shadow: 0 4px 10px rgba(61,58,52,.12); }
.otd-date { color: var(--ink-soft); font-size: 14px; }
.otd-title { font-size: 22px; margin: 4px 0 8px; }
.otd-text { color: var(--ink-soft); font-size: 15px; }
@media (max-width: 560px) { .otd-body { flex-direction: column; } .otd-img { width: 100%; } }
.section-title { margin: 44px 0 26px; font-size: 26px; display: flex; align-items: baseline; justify-content: space-between; }
.section-title .more { font-size: 15px; color: var(--accent); }
.memory-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 34px; padding: 14px 6px; }
.no-photo { aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; font-size: 64px; background: var(--paper-dark); border-radius: 2px; }
</style>

<script is:inline define:vars={{ allMemories, quotes: site.quotes, siteCfg: { coupleName: site.coupleName, startDate: site.startDate, anniversary: site.anniversary } }}>
  window.__ALL_MEMORIES = allMemories;
  window.__QUOTES = quotes;
  window.__SITE_CFG = siteCfg;
</script>

<script>
  // 站点设置：在线编辑情侣名/在一起日期/纪念日，覆盖 config 默认值
  import { isLoggedIn, askPassword } from '../scripts/memory-admin';
  import { authHeaders } from '../scripts/memories-shared';

  const cfg = { ...(window as any).__SITE_CFG };

  function calcDays(startDate: string) {
    return Math.floor((Date.now() - new Date(startDate + 'T00:00:00').getTime()) / 86400000) + 1;
  }

  function renderUpcoming() {
    const box = document.getElementById('upcoming')!;
    const today = new Date();
    const list = (cfg.anniversary || []).map((a: any) => {
      const d = new Date(a.date);
      let next = new Date(today.getFullYear(), d.getMonth(), d.getDate());
      if (next < today) next = new Date(today.getFullYear() + 1, d.getMonth(), d.getDate());
      return { ...a, left: Math.ceil((next.getTime() - today.getTime()) / 86400000) };
    }).sort((a: any, b: any) => a.left - b.left);
    if (!list.length) { (box as HTMLElement).hidden = true; return; }
    const u = list[0];
    (box as HTMLElement).hidden = false;
    box.innerHTML = `📅 距离「${u.title}」纪念日还有
      <span class="flip-clock" data-value="${u.left}" aria-label="${u.left} 天"></span> 天`;
    (window as any).__initFlip?.();
  }

  function applyCfg() {
    document.querySelector('.hero-title')!.textContent = cfg.coupleName;
    document.querySelector('.heartbeat-num')!.textContent = String(calcDays(cfg.startDate));
    document.querySelector('.days-date')!.textContent = '始于 ' + cfg.startDate.replaceAll('-', '.');
    // 开屏封面同步
    const bn = document.querySelector('.book-names'); if (bn) bn.textContent = cfg.coupleName;
    const bd = document.querySelector('.book-date'); if (bd) bd.textContent = '始于 ' + cfg.startDate.replaceAll('-', '.');
    renderUpcoming();
  }

  // 拉取云端设置覆盖默认值
  fetch('/api/settings').then(r => r.ok ? r.json() : {}).then(remote => {
    if (remote && Object.keys(remote).length) {
      Object.assign(cfg, remote);
      applyCfg();
    }
  }).catch(() => { /* 静态预览保持默认 */ });

  // 设置弹层
  document.getElementById('settings-btn')!.addEventListener('click', () => {
    if (!isLoggedIn()) { askPassword(() => openSettings()); return; }
    openSettings();
  });

  function openSettings() {
    document.getElementById('settings-modal')?.remove();
    const modal = document.createElement('div');
    modal.id = 'settings-modal';
    modal.className = 'admin-modal';
    const rows = (cfg.anniversary || []).map((a: any, i: number) => `
      <div class="ann-row" data-i="${i}">
        <input class="ann-title" placeholder="名称（如：在一起）" maxlength="20" value="${a.title}" />
        <input class="ann-date" type="date" value="${a.date}" />
        <button type="button" class="ann-del" title="删除">×</button>
      </div>`).join('');
    modal.innerHTML = `
      <div class="admin-modal-card card">
        <h3 style="margin-bottom:18px">站点设置</h3>
        <div style="margin-bottom:12px"><label>情侣名</label><input id="set-name" maxlength="30" value="${cfg.coupleName}" /></div>
        <div style="margin-bottom:12px"><label>在一起日期</label><input id="set-start" type="date" value="${cfg.startDate}" /></div>
        <label>纪念日（首页倒计时取最近一个）</label>
        <div id="ann-list">${rows}</div>
        <button type="button" class="btn ghost" id="ann-add" style="margin-top:10px">＋ 加纪念日</button>
        <div class="admin-form-actions">
          <button type="button" class="btn ghost" id="set-cancel">取消</button>
          <button type="button" class="btn" id="set-save">保存</button>
        </div>
      </div>`;
    document.body.appendChild(modal);
    const close = () => modal.remove();
    modal.querySelector('#set-cancel')!.addEventListener('click', close);
    modal.addEventListener('click', e => { if (e.target === modal) close(); });
    modal.querySelector('#ann-add')!.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'ann-row';
      row.innerHTML = `<input class="ann-title" placeholder="名称" maxlength="20" />
        <input class="ann-date" type="date" />
        <button type="button" class="ann-del" title="删除">×</button>`;
      row.querySelector('.ann-del')!.addEventListener('click', () => row.remove());
      modal.querySelector('#ann-list')!.appendChild(row);
    });
    modal.querySelectorAll('.ann-del').forEach(b => b.addEventListener('click', () => (b as HTMLElement).closest('.ann-row')!.remove()));

    modal.querySelector('#set-save')!.addEventListener('click', async () => {
      const payload = {
        coupleName: (modal.querySelector('#set-name') as HTMLInputElement).value,
        startDate: (modal.querySelector('#set-start') as HTMLInputElement).value,
        anniversary: [...modal.querySelectorAll('.ann-row')].map(r => ({
          title: (r.querySelector('.ann-title') as HTMLInputElement).value,
          date: (r.querySelector('.ann-date') as HTMLInputElement).value,
        })),
      };
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...authHeaders() },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        Object.assign(cfg, data);
        applyCfg();
        close();
      } else {
        alert(data.error || '保存失败');
      }
    });
  }
</script>

<script>
  // 每日一句：按日期轮换 + 打字机效果
  const quotes = (window as any).__QUOTES || [];
  if (quotes.length) {
    const dayIndex = Math.floor(Date.now() / 86400000) % quotes.length;
    const text = '「 ' + quotes[dayIndex] + ' 」';
    const el = document.getElementById('daily-quote')!;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = text;
    } else {
      el.classList.add('typewriter');
      let i = 0;
      const timer = setInterval(() => {
        el.textContent = text.slice(0, ++i);
        if (i >= text.length) {
          clearInterval(timer);
          el.classList.remove('typewriter');
        }
      }, 85);
    }
  }

  // 想你了按钮
  const missBtn = document.getElementById('miss-btn')!;
  const missCount = document.getElementById('miss-count')!;
  const showMiss = (n: number) => { missCount.textContent = n > 0 ? `今天已被想念 ${n} 次` : '今天还没人按过'; };
  fetch('/api/miss').then(r => r.ok ? r.json() : { count: 0 }).then(d => showMiss(d.count)).catch(() => { missCount.textContent = ''; });
  missBtn.addEventListener('click', async () => {
    missBtn.classList.remove('miss-pop');
    void (missBtn as HTMLElement).offsetWidth;
    missBtn.classList.add('miss-pop');
    try {
      const res = await fetch('/api/miss', { method: 'POST' });
      const d = await res.json();
      showMiss(d.count);
      if (d.count === 3 || d.count === 10) {
        const { confetti } = await import('../scripts/confetti');
        confetti(40);
      }
    } catch { /* 本地静态预览无后端时静默 */ }
  });
</script>

<script>
  // 那年今日：同月日的往年回忆优先，没有则随机抽一条
  import { fetchOnlineMemories, esc } from '../scripts/memories-shared';

  (async () => {
    const box = document.getElementById('on-this-day')!;
    const staticList = (window as any).__ALL_MEMORIES || [];
    let online: any[] = [];
    try { online = await fetchOnlineMemories(); } catch { /* 静态预览无后端时忽略 */ }
    const all = [...staticList, ...online.map(m => ({
      title: m.title, date: m.date, sortDate: m.sortDate,
      image: m.image || '', alt: m.alt || '', body: m.content,
    }))];
    if (!all.length) return;

    const now = new Date();
    const md = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const thisYear = now.getFullYear();
    const matched = all.filter(m => m.sortDate.slice(5) === md && Number(m.sortDate.slice(0, 4)) < thisYear);

    let picked: any, label: string;
    if (matched.length) {
      picked = matched[Math.floor(Math.random() * matched.length)];
      label = `那年今日 · ${thisYear - Number(picked.sortDate.slice(0, 4))} 年前的今天`;
    } else {
      picked = all[Math.floor(Math.random() * all.length)];
      label = '随机翻一页';
    }

    box.innerHTML = `
      <a class="otd-card card" href="/timeline/">
        <div class="otd-label">📖 ${label}</div>
        <div class="otd-body">
          ${picked.image ? `<img class="otd-img" src="${esc(picked.image)}" alt="${esc(picked.alt || picked.title)}" />` : ''}
          <div>
            <div class="otd-date">${esc(picked.date)}</div>
            <h3 class="otd-title">${esc(picked.title)}</h3>
            <p class="otd-text">${esc(picked.body).slice(0, 90)}${picked.body.length > 90 ? '…' : ''}</p>
          </div>
        </div>
      </a>`;
    (box as HTMLElement).hidden = false;
  })();
</script>

<script>
  // 纪念日翻牌：数字快速翻动后逐位定格（暴露给设置更新后重放）
  (window as any).__initFlip = () => {
  document.querySelectorAll<HTMLElement>('.flip-clock').forEach(clock => {
    const target = clock.dataset.value || '0';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const digits = target.split('').map(() => {
      const d = document.createElement('span');
      d.className = 'flip-digit';
      d.textContent = '0';
      clock.appendChild(d);
      return d;
    });
    if (reduced) { digits.forEach((d, i) => d.textContent = target[i]); return; }
    let step = 0;
    const totalSteps = 14;
    const timer = setInterval(() => {
      step++;
      digits.forEach((d, i) => {
        const settleAt = totalSteps - (digits.length - 1 - i) * 3; // 高位先停，个位最后停
        if (step >= settleAt) {
          if (d.textContent !== target[i]) {
            d.textContent = target[i];
            d.classList.remove('flipping');
            void d.offsetWidth;
            d.classList.add('flipping');
          }
        } else {
          d.textContent = String(Math.floor(Math.random() * 10));
          d.classList.remove('flipping');
          void d.offsetWidth;
          d.classList.add('flipping');
        }
      });
      if (step >= totalSteps) clearInterval(timer);
    }, 90);
  });
  };
  (window as any).__initFlip();
</script>
