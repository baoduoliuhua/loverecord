---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import { getCollection, render } from 'astro:content';

const memories = (await getCollection('timeline'))
  .sort((a, b) => a.data.sortDate.localeCompare(b.data.sortDate));
---
<Base title="时间轴" active="/timeline/">
  <h1 class="hand-title">回忆展馆</h1>
  <p class="hand-sub">从相识那天起，每一件都值得陈列</p>

  <div class="timeline">
    {memories.map(async (item, i) => {
      const { Content } = await render(item);
      return (
        <article class={`tl-item ${item.data.side}`}>
          <div class="tl-dot"></div>
          <div class="tl-card card reveal">
            <div class="tl-date">{item.data.date}</div>
            <h2 class="tl-title">{item.data.title}</h2>
            {item.data.image && (
              <figure class={`polaroid tape ${item.data.tilt}`}>
                <img src={item.data.image} alt={item.data.alt} loading="lazy" />
              </figure>
            )}
            <Scene scene={item.data.scene} />
            <div class="tl-content"><Content /></div>
          </div>
        </article>
      );
    })}
  </div>
  <p class="tl-end">—— 未完待续 ——</p>
</Base>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script is:inline>
  // 滚动叙事：卡片从各自一侧 3D 翻转入场，照片轻微视差
  window.addEventListener('load', () => {
    if (typeof gsap === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.registerPlugin(ScrollTrigger);

    document.querySelectorAll('.tl-item').forEach(item => {
      const card = item.querySelector('.tl-card');
      const fromLeft = item.classList.contains('left');
      gsap.set(card, { transformPerspective: 900 });
      gsap.fromTo(card,
        {
          opacity: 0,
          x: fromLeft ? -90 : 90,
          rotationY: fromLeft ? 24 : -24,
          rotationX: 6,
        },
        {
          opacity: 1, x: 0, rotationY: 0, rotationX: 0,
          duration: 1.1, ease: 'power3.out',
          scrollTrigger: { trigger: item, start: 'top 82%', toggleActions: 'play none none reverse' },
        }
      );

      const photo = item.querySelector('.polaroid');
      if (photo) {
        gsap.fromTo(photo, { y: 26 }, {
          y: -26, ease: 'none',
          scrollTrigger: { trigger: item, start: 'top bottom', end: 'bottom top', scrub: 1.2 },
        });
      }
    });
  });
</script>

<style>
.timeline { position: relative; max-width: 860px; margin: 0 auto; padding: 20px 0 40px; }
.timeline::before {
  content: ''; position: absolute; left: 50%; top: 0; bottom: 0;
  border-left: 3px dashed #d9cbb4; transform: translateX(-50%);
}
.tl-item { position: relative; width: 50%; padding: 0 40px 48px; }
.tl-item.left { left: 0; text-align: right; }
.tl-item.right { left: 50%; }
.tl-dot {
  position: absolute; top: 26px; width: 16px; height: 16px;
  background: var(--accent); border: 3px solid var(--paper);
  border-radius: 50%; box-shadow: 0 0 0 2px var(--accent);
}
.tl-item.left .tl-dot { right: -8px; }
.tl-item.right .tl-dot { left: -8px; }
.tl-card { display: inline-block; text-align: left; width: 100%; }
.tl-date { color: var(--accent); font-size: 15px; letter-spacing: .1em; }
.tl-title { font-size: 24px; margin: 4px 0 14px; }
.tl-content { color: var(--ink-soft); font-size: 16px; }
.tl-end { text-align: center; color: var(--ink-soft); padding-bottom: 40px; }

@media (max-width: 720px) {
  .timeline::before { left: 12px; }
  .tl-item, .tl-item.left, .tl-item.right { width: 100%; left: 0; text-align: left; padding: 0 0 40px 40px; }
  .tl-item.left .tl-dot, .tl-item.right .tl-dot { left: 5px; right: auto; }
}
</style>
