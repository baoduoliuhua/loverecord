---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';

const wishes = parse(readFileSync('src/content/wishes.yaml', 'utf-8')) as { title: string; done: boolean }[];
const doneCount = wishes.filter(w => w.done).length;
---
<Base title="愿望清单" active="/wishes/">
  <h1 class="hand-title">愿望清单</h1>
  <p class="hand-sub">一起完成的小事，已达成 {doneCount} / {wishes.length}</p>

  <div class="wish-progress"><div class="wish-bar" style={`width:${Math.round(doneCount / wishes.length * 100)}%`}></div></div>

  <ul class="wish-list">
    {wishes.map((w, i) => (
      <li class={`wish card ${w.done ? 'done' : ''}`} data-index={i}>
        <label class="wish-label">
          <input type="checkbox" class="wish-check" checked={w.done} />
          <span class="wish-box" aria-hidden="true">{w.done ? '✓' : ''}</span>
          <span class="wish-title">{w.title}</span>
        </label>
      </li>
    ))}
  </ul>
  <p class="wish-tip">勾选状态保存在这台设备的浏览器里；默认清单改 <code>src/content/wishes.yaml</code></p>
</Base>

<style>
.wish-progress { max-width: 560px; margin: 0 auto 36px; height: 10px; background: #ece2d0; border-radius: 6px; overflow: hidden; }
.wish-bar { height: 100%; background: var(--green); border-radius: 6px; transition: width .5s; }
.wish-list { max-width: 560px; margin: 0 auto; list-style: none; display: grid; gap: 16px; }
.wish { padding: 16px 22px; transition: transform .2s; }
.wish:hover { transform: translateX(4px); }
.wish-label { display: flex; align-items: center; gap: 14px; cursor: pointer; margin: 0; }
.wish-check { display: none; }
.wish-box {
  width: 26px; height: 26px; flex: none;
  border: 2px solid var(--accent); border-radius: 8px 10px 7px 11px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 17px; background: transparent; transition: background .2s;
}
.wish-check:checked + .wish-box { background: var(--accent); }
.wish-title { font-size: 18px; color: var(--ink); }
.wish.done .wish-title { color: var(--ink-soft); text-decoration: line-through wavy rgba(212,123,92,.6); }
.wish-tip { text-align: center; color: var(--ink-soft); font-size: 13px; margin-top: 30px; }
</style>
<script>
  const KEY = 'lovereocrd-wishes';
  const saved: number[] = JSON.parse(localStorage.getItem(KEY) || '[]');
  document.querySelectorAll<HTMLLIElement>('.wish').forEach(li => {
    const idx = Number(li.dataset.index);
    const check = li.querySelector<HTMLInputElement>('.wish-check')!;
    const box = li.querySelector<HTMLElement>('.wish-box')!;
    const wishTitle = li.querySelector('.wish-title')?.textContent || '';
    const apply = (on: boolean) => {
      li.classList.toggle('done', on);
      box.textContent = on ? '✓' : '';
    };
    if (saved.includes(idx)) { check.checked = true; apply(true); }
    check.addEventListener('change', async () => {
      apply(check.checked);
      const set = new Set<number>(JSON.parse(localStorage.getItem(KEY) || '[]'));
      check.checked ? set.add(idx) : set.delete(idx);
      localStorage.setItem(KEY, JSON.stringify([...set]));

      // 愿望达成：撒花；已登录时自动在时间轴生成一条回忆
      if (check.checked) {
        const { confetti } = await import('../scripts/confetti');
        confetti(60);
        const { isLoggedIn } = await import('../scripts/memory-admin');
        if (isLoggedIn()) {
          try {
            const { saveMemory } = await import('../scripts/memories-shared');
            const today = new Date().toISOString().slice(0, 10);
            await saveMemory({
              title: `🎉 愿望达成：${wishTitle}`,
              sortDate: today,
              date: today.replaceAll('-', '.'),
              scene: 'fireworks',
              content: '又一起完成了一件想做的事。',
            }, false);
          } catch { /* 创建失败不影响勾选 */ }
        }
      }
    });
  });
</script>
